  <connection name="Value" Expression="{SupplyPressure}"/>
  </gauge>
  <gauge name="PressGauge" left="280" top="79" width="70" height="84" min="0" max="80">
  <connection name="Value" Expression="{ChamberPressure}"/>
  </gauge>
  <numericdisplay name="PressValue" left="305" top="146" width="30" height="11" fontsize="8" forecolor="#FFFFFF">
  <connection name="Value" Expression="{ChamberPressure}"/>
  </numericdisplay>
  <text name="HGPGaugeLabel" left="500" top="77" width="80" height="8" fontsize="8" forecolor="#C8D3DE" caption="HGP (IN H2O)"/>
