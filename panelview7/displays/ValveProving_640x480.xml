  <ellipse name="StepLed1" left="24" top="230" width="10" height="12">
  <animations>
    <color type="fill">
      <connection name="Expression" Expression="If {State} = 1 Then 1 Else If ({State} &gt; 1) And ({State} &lt; 8) Then 2 Else 0"/>
      <state value="0" color="#3B4654"/>
      <state value="1" color="#FFC400"/>
      <state value="2" color="#2ECC71"/>
