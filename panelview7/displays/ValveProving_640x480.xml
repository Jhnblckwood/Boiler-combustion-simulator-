    <color type="fill">
      <connection name="Expression" Expression="{SupplyPressure} &gt;= 1"/>
      <state value="0" color="#3B4654"/>
      <state value="1" color="#FFC400"/>
    </color>
  </animations>
  </rectangle>
  <rectangle name="Actuator1" left="178" top="100" width="35" height="57" backcolor="#00707E"/>
  <text name="Actuator1Label" left="184" top="124" width="25" height="11" fontsize="8" forecolor="#FFFFFF" caption="SKP15"/>
