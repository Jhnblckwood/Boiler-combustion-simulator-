<gfx name="ValveProving" width="640" height="480" backcolor="#151E27">
  <text name="Title" left="20" top="8" width="300" height="20" fontsize="12" forecolor="#FFFFFF" caption="VALVE PROVING SYSTEM"/>
  <text name="Subtitle" left="20" top="31" width="500" height="11" fontsize="8" forecolor="#8FA3B8" caption="HONEYWELL 7800 SERIES - SIEMENS SKP - TAGS VP1 VP2 VPS LGP HGP"/>
