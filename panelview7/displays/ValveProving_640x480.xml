  <connection name="Value" Expression="{State}"/>
  <state value="0" caption="STANDBY - READY TO START" backcolor="#212D3B"/>
  <state value="1" caption="STEP 1: EVACUATE (OPEN V2)" backcolor="#1F4E79"/>
  <state value="2" caption="STEP 2: TEST V1 - PRESSURE MUST STAY LOW" backcolor="#1F4E79"/>
  <state value="3" caption="STEP 3: FILL (OPEN V1)" backcolor="#1F4E79"/>
  <state value="4" caption="STEP 4: TEST V2 - PRESSURE MUST STAY HIGH" backcolor="#1F4E79"/>
  <state value="5" caption="PROVEN - PREPURGE" backcolor="#1F4E79"/>
  <state value="6" caption="PILOT TRIAL FOR IGNITION" backcolor="#1F4E79"/>
  <state value="7" caption="BURNER FIRING - VALVES PROVEN" backcolor="#14532D"/>
  <state value="8" caption="SAFETY LOCKOUT - PRESS STOP/RESET" backcolor="#7F1D1D"/>
  </multistateindicator>
  <text name="InletLabel" left="20" top="77" width="70" height="8" fontsize="8" forecolor="#C8D3DE" caption="INLET (IN H2O)"/>
