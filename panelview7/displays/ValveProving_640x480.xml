    <color type="fill">
      <connection name="Expression" Expression="{VP1}"/>
      <state value="0" color="#E74C3C"/>
      <state value="1" color="#2ECC71"/>
    </color>
  </animations>
  </rectangle>
  <rectangle name="PipeChamber" left="220" top="175" width="190" height="11">
