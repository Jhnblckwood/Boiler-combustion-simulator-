<?xml version="1.0" encoding="utf-8"?>
<!--
  ValveProving_display.xml  -  FactoryTalk View ME graphic display STARTER
  ============================================================================
  This is a best-effort scaffold in the FactoryTalk View gfx XML shape (root
  <gfx>, objects carry a <connection> whose Expression holds the {tag}). It is
  NOT guaranteed to import untouched: the exact ME element/attribute set is
  version-specific and could not be validated here. Use it two ways:
    1. As a pattern reference - each object below shows the exact connection
       expression / animation you need for that widget.
    2. As an import attempt - Tools > Import and Export Wizard in FT View
       Studio; if it rejects an element, build that object by hand from the
       README build spec (which is the authoritative screen definition) and
       paste the connection expression shown here.
  The quickest reliable path Rockwell recommends: create ONE of each object
  type in Studio, export to XML, and copy these connection strings into it.
  Coordinates are pixels on a 1280x800 PanelView Plus 7 display.
============================================================================ -->
<gfx name="ValveProving" width="1280" height="800" backcolor="#151E27">

  <!-- ===== titles ===== -->
  <text name="Title" left="40" top="14" width="600" height="34" fontsize="24"
        forecolor="#FFFFFF" caption="VALVE PROVING SYSTEM (PanelView Plus 7)"/>
  <text name="Subtitle" left="40" top="52" width="1000" height="18" fontsize="12"
        forecolor="#8FA3B8"
        caption="HONEYWELL 7800 SERIES - SIEMENS SKP - TAGS VP1 VP2 VPS LGP HGP"/>

  <!-- ===== status banner: multistate text driven by State, color by Lockout =====
       Build as a Multistate Indicator: connection State, states 0..8 with the
       captions and background colors listed in the README build spec. -->
  <multistateindicator name="Banner" left="40" top="80" width="1200" height="42">
    <connection name="Value" Expression="{State}"/>
    <!-- state captions/colors: see README 'Banner states' table -->
  </multistateindicator>

  <!-- ===== INLET gauge (the only operator-adjustable pressure) =====
       ME gauge object bound to SupplyPressure, min 0 max 80. Adjust with the
       INLET +/- buttons below. -->
  <gauge name="InletGauge" left="40" top="150" width="110" height="110" min="0" max="80">
    <connection name="Value" Expression="{SupplyPressure}"/>
  </gauge>
  <numericdisplay name="InletValue" left="72" top="235" width="46" height="18"
                  decimalplaces="1" forecolor="#FFFFFF">
    <connection name="Value" Expression="{SupplyPressure}"/>
  </numericdisplay>

  <!-- LGP gauge (read-only), before V1 -->
  <gauge name="LGPGauge" left="190" top="150" width="110" height="110" min="0" max="80">
    <connection name="Value" Expression="{SupplyPressure}"/>
  </gauge>

  <!-- Test-volume gauge (read-only) -->
  <gauge name="PressGauge" left="560" top="132" width="140" height="140" min="0" max="80">
    <connection name="Value" Expression="{ChamberPressure}"/>
  </gauge>

  <!-- HGP gauge (read-only), downstream of V2 -->
  <gauge name="HGPGauge" left="1000" top="150" width="110" height="110" min="0" max="80">
    <connection name="Value" Expression="{DownstreamPressure}"/>
  </gauge>

  <!-- ===== piping: rectangle fill color animated by gas-present logic =====
       Supply header live whenever inlet gas present. -->
  <rectangle name="PipeSupply" left="40" top="292" width="300" height="18">
    <animations>
      <color type="fill">
        <connection name="Expression" Expression="{SupplyPressure} >= 1"/>
        <state value="0" color="#3B4654"/>   <!-- no gas: gray -->
        <state value="1" color="#FFC400"/>   <!-- gas present: yellow -->
      </color>
    </animations>
  </rectangle>
  <!-- Test-volume pipe: yellow when V1 charging or chamber has gas -->
  <rectangle name="PipeChamber" left="440" top="292" width="380" height="18">
    <animations>
      <color type="fill">
        <connection name="Expression" Expression="{VP1} OR {ChamberPressure} > 8"/>
        <state value="0" color="#3B4654"/>
        <state value="1" color="#FFC400"/>
      </color>
    </animations>
  </rectangle>
  <!-- Downstream pipe: yellow only when V2 passes gas -->
  <rectangle name="PipeDownstream" left="920" top="292" width="220" height="18">
    <animations>
      <color type="fill">
        <connection name="Expression" Expression="{VP2} AND ({VP1} OR {ChamberPressure} > 8)"/>
        <state value="0" color="#3B4654"/>
        <state value="1" color="#FFC400"/>
      </color>
    </animations>
  </rectangle>

  <!-- ===== valves: green open / red closed ===== -->
  <rectangle name="Valve1" left="340" top="271" width="100" height="60">
    <animations>
      <color type="fill">
        <connection name="Expression" Expression="{VP1}"/>
        <state value="0" color="#E74C3C"/>
        <state value="1" color="#2ECC71"/>
      </color>
    </animations>
  </rectangle>
  <rectangle name="Valve2" left="820" top="271" width="100" height="60">
    <animations>
      <color type="fill">
        <connection name="Expression" Expression="{VP2}"/>
        <state value="0" color="#E74C3C"/>
        <state value="1" color="#2ECC71"/>
      </color>
    </animations>
  </rectangle>

  <!-- ===== switch LEDs (VPS/LGP/HGP) and flames: same fill-color pattern =====
       VpsLed: red when {VPS}. LgpLed: green when {LGP}. HgpLed: red when {HGP}.
       FlamePilot visible when {Flame_Pilot}; FlameMain visible when {Flame_Main}.
       Build each as a small rectangle/ellipse with the connection shown. -->
  <ellipse name="VpsLed" left="708" top="231" width="24" height="24">
    <animations>
      <color type="fill">
        <connection name="Expression" Expression="{VPS}"/>
        <state value="0" color="#2ECC71"/>
        <state value="1" color="#E74C3C"/>
      </color>
    </animations>
  </ellipse>

  <!-- ===== numeric setpoint inputs (0-80, numeric keypad) =====
       ME Numeric Input Enable object; enter key writes the tag. Set the object's
       Minimum=0 Maximum=80 so out-of-range and non-numeric entries are refused. -->
  <numericinput name="LgpSet" left="140" top="336" width="60" height="24" min="0" max="80">
    <connection name="Value" Expression="{LGPSetpoint}"/>
  </numericinput>
  <numericinput name="HgpSet" left="966" top="336" width="60" height="24" min="0" max="80">
    <connection name="Value" Expression="{HGPSetpoint}"/>
  </numericinput>
  <numericinput name="VpsSet" left="700" top="196" width="60" height="24" min="0" max="80">
    <connection name="Value" Expression="{VPSSetpoint}"/>
  </numericinput>

  <!-- ===== buttons: momentary, set the Cmd_ bit on press =====
       ME Momentary Push Button, Action = Set, releases to 0; the PLC one-shots
       it. START/STOP/MODE plus manual VP1/VP2/PILOT and the sim toggles. -->
  <momentarybutton name="StartBtn" left="920" top="468" width="145" height="44"
                   caption="START BURNER" action="set">
    <connection name="Value" Expression="{Cmd_Start}"/>
  </momentarybutton>
  <momentarybutton name="StopBtn" left="1075" top="468" width="145" height="44"
                   caption="STOP / RESET" action="set">
    <connection name="Value" Expression="{Cmd_Stop}"/>
  </momentarybutton>
  <momentarybutton name="ModeBtn" left="920" top="420" width="300" height="38"
                   caption="TOGGLE AUTO / MANUAL" action="set">
    <connection name="Value" Expression="{Cmd_ToggleMode}"/>
  </momentarybutton>
  <momentarybutton name="InletUpBtn" left="1075" top="730" width="145" height="32"
                   caption="INLET PRESSURE +" action="set">
    <connection name="Value" Expression="{Cmd_InletUp}"/>
  </momentarybutton>
  <momentarybutton name="InletDnBtn" left="920" top="730" width="145" height="32"
                   caption="INLET PRESSURE -" action="set">
    <connection name="Value" Expression="{Cmd_InletDown}"/>
  </momentarybutton>
  <!-- Remaining buttons (VP1, VP2, PILOT, SIM V1/V2 LEAK, SIM PILOT FAIL)
       follow the exact same pattern - see README build spec for positions
       and the Cmd_ tag each one sets. -->

</gfx>
